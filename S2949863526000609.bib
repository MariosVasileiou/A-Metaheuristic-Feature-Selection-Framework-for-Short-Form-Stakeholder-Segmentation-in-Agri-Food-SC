@article{VASILEIOU2026100251,
title = {A metaheuristic feature selection framework for short-form stakeholder segmentation in agri-food supply chains},
journal = {Supply Chain Analytics},
volume = {16},
pages = {100251},
year = {2026},
issn = {2949-8635},
doi = {10.1016/j.sca.2026.100251},
url = {https://www.sciencedirect.com/science/article/pii/S2949863526000609},
author = {Marios Vasileiou and Pantelis Z. Lappas and Leonidas Sotirios Kyrgiakos and Christina Kleisiari and Georgios Kleftodimos and George Vlontzos},
keywords = {Metaheuristic method, Feature selection, Survey optimisation, Agri-food supply chain, Stakeholder segmentation, Traceability systems},
abstract = {Stakeholder-perception surveys are central to meso-economic analysis of technology diffusion in agri-food supply chains, but long multi-domain questionnaires impose respondent burden, particularly along Geographical-Indication (GI) and organic value chains. This paper proposes a Tabu Search framework that treats short-form item selection as a combinatorial optimisation problem, using the segmentation structure of the full instrument as the reference to preserve. Candidate subsets are scored by a composite fidelity objective combining (i) Procrustes similarity between the principal-component scores of the reduced and full instruments and (ii) the Adjusted Rand Index (ARI) of the induced stakeholder-profile assignments, with a sparsity penalty. The method is applied to a 40-item survey of 42 stakeholders from seven GI and organic pilot value chains in seven European countries, eliciting perceptions of traceability and anti-fraud innovations. Principal Component Analysis retains four components (68.1% of variance), and Ward hierarchical clustering identifies four profiles: Pragmatic Optimists, Committed Enthusiasts, Operationally Cautious, and Risk-Averse Sceptics. Across 30 runs the algorithm converges to short forms of seven to eleven items that recover the segmentation with perfect agreement (ARI = 1.000) and high geometric fidelity (mean Procrustes 0.907). The best-of-run solution retains seven items and attains a higher composite objective than eight alternative wrapper, filter, and embedded procedures evaluated at the same size. Repeated subsampling (200 subsamples of the same records) shows that perfect profile recovery is reproduced in every subsample, with Q8 and Q21 forming a robust core. The contribution is twofold: methodological, providing a metaheuristic item-selection framework portable across stakeholder surveys in supply chain management; and practical, delivering an internally validated candidate short form for monitoring adoption readiness for traceability innovations in agri-food chains.}
}